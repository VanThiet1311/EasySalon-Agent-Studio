# ==============================================================================
# EasySalon Agent Bridge - Cấu hình mẫu (.env.example)
# ==============================================================================
# Khi gửi mã nguồn sang máy khác, hãy sao chép file này thành .env:
#   cp .env.example .env
# Sau đó chỉnh sửa 2 đường dẫn FE_WORKSPACE và BE_WORKSPACE bên dưới cho đúng vị trí máy mới.

# 1. Đường dẫn thư mục mã nguồn Frontend (React/TypeScript - easysalon-webapp)
FE_WORKSPACE=/path/to/easysalon-webapp

# 2. Đường dẫn thư mục mã nguồn Backend (.NET API - easysalon-api)
BE_WORKSPACE=/path/to/easysalon-api

# 3. Cấu hình cổng mạng Web Studio UI (Tùy chọn, mặc định 8765)
WEB_PORT=8765
WEB_HOST=0.0.0.0

# 4. Cấu hình Telegram Bot (@easysalon_bot)
TELEGRAM_BOT_TOKEN=123
TELEGRAM_BOT_NAME=123
TELEGRAM_ALLOWED_USERS=123
TELEGRAM_ENABLED=123
